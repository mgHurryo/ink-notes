{
  "name": "obsidian-ink-notes",
  "version": "0.1.0-beta.3",
  "private": true,
  "description": "Cross-platform handwritten notes for Obsidian.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --format=cjs --platform=node --target=es2018 --outdir=. --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
