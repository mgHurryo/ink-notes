{
  "name": "obsidian-ink-notes",
  "version": "0.1.0-beta.4",
  "private": true,
  "description": "Cross-platform handwritten notes for Obsidian.",
  "main": "main.js",
  "scripts": {
    "preview": "node dev/serve.mjs",
    "build": "esbuild src/main.ts --bundle --external:obsidian --format=cjs --platform=node --target=es2018 --outdir=. --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "lucide": "^1.42.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  }
}
